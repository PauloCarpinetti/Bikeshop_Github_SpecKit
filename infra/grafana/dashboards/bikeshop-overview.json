{
  "uid": "bikeshop-overview",
  "title": "BikeShop — Checkout, Pagamentos, Estoque e Pedidos",
  "description": "T089 (Fase 6): taxa de requisições, taxa de erro (5xx) e latência p95 por domínio, a partir das métricas HTTP auto-instrumentadas pelo Micrometer (http_server_requests_seconds_*).",
  "tags": ["bikeshop"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Checkout — Taxa de requisições",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/checkout/.*\"}[5m]))", "legendFormat": "req/s" } ] },
    { "id": 2, "type": "timeseries", "title": "Checkout — Taxa de erro (5xx)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/checkout/.*\",status=~\"5..\"}[5m]))", "legendFormat": "erros/s" } ] },
    { "id": 3, "type": "timeseries", "title": "Checkout — Latência p95",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/checkout/.*\"}[5m])) by (le))", "legendFormat": "p95" } ] },

    { "id": 4, "type": "timeseries", "title": "Pagamentos — Taxa de requisições",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/payments/.*\"}[5m]))", "legendFormat": "req/s" } ] },
    { "id": 5, "type": "timeseries", "title": "Pagamentos — Taxa de erro (5xx)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/payments/.*\",status=~\"5..\"}[5m]))", "legendFormat": "erros/s" } ] },
    { "id": 6, "type": "timeseries", "title": "Pagamentos — Latência p95",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/payments/.*\"}[5m])) by (le))", "legendFormat": "p95" } ] },

    { "id": 7, "type": "timeseries", "title": "Estoque — Taxa de requisições",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/admin/products/{sku}/stock\"}[5m]))", "legendFormat": "req/s" } ] },
    { "id": 8, "type": "timeseries", "title": "Estoque — Taxa de erro (5xx)",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/admin/products/{sku}/stock\",status=~\"5..\"}[5m]))", "legendFormat": "erros/s" } ] },
    { "id": 9, "type": "timeseries", "title": "Estoque — Latência p95",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/admin/products/{sku}/stock\"}[5m])) by (le))", "legendFormat": "p95" } ] },

    { "id": 10, "type": "timeseries", "title": "Pedidos — Taxa de requisições",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/(checkout/orders|admin/orders.*|account/orders.*)\"}[5m]))", "legendFormat": "req/s" } ] },
    { "id": 11, "type": "timeseries", "title": "Pedidos — Taxa de erro (5xx)",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/(checkout/orders|admin/orders.*|account/orders.*)\",status=~\"5..\"}[5m]))", "legendFormat": "erros/s" } ] },
    { "id": 12, "type": "timeseries", "title": "Pedidos — Latência p95",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/(checkout/orders|admin/orders.*|account/orders.*)\"}[5m])) by (le))", "legendFormat": "p95" } ] }
  ]
}
