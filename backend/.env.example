DB_URL=jdbc:mysql://localhost:3308/bikeshop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=bikeshop
DB_PASSWORD=bikeshop
REDIS_HOST=localhost
REDIS_PORT=6380
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey
JWT_SECRET=change-me-in-production-change-me-in-production
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
FRONTEND_ORIGIN=http://localhost:3002
CART_TTL_DAYS=30

# Sub-bloco 3B — sem essas credenciais, o sistema funciona em modo simulado (frete estimado,
# pagamento simulado com status PENDING). Preencha quando tiver as contas sandbox/contrato.
CORREIOS_API_USUARIO=
CORREIOS_API_SENHA=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAGSEGURO_TOKEN=
PAGSEGURO_WEBHOOK_TOKEN=

# Sub-bloco 3C — sem SENDGRID_API_KEY, a confirmação de pedido por e-mail é simulada (logada).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=pedidos@bikeshop.example

# Sub-bloco 5A — credenciais do usuário administrativo criado no primeiro start (AdminUserSeeder).
# Troque a senha antes de qualquer deploy real.
ADMIN_SEED_EMAIL=admin@bikeshop.example
ADMIN_SEED_PASSWORD=admin12345
